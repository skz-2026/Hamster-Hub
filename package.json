{
  "name": "hamster-hub",
  "private": true,
  "version": "0.1.2",
  "license": "MIT",
  "description": "仓鼠Hub —— 把桌面，囤进一个窝。Windows 本地优先的智能桌面助手",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "tauri": "tauri",
    "icon": "node scripts/make-icon.mjs",
    "codegen:ipc": "cargo test --manifest-path src-tauri/Cargo.toml export_bindings",
    "verify:updater": "node scripts/verify-updater.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.18",
    "@tanstack/react-query": "^5.59.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-autostart": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chrono-node": "^2.10.1",
    "highlight.js": "^11.12.0",
    "lucide-react": "^0.460.0",
    "lunar-javascript": "^1.7.3",
    "markdown-it": "^15.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
