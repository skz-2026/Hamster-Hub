# deps
node_modules/

# build
dist/
dist-docs/
# src-tauri/target*/ 覆盖 target / target-verify / target-live-test 等一切 cargo 目标目录
# （target-verify 是绕开「运行中的 dev 实例占用 target/ 文件锁」时用的独立目标目录）
src-tauri/target*/
src-tauri/gen/

# generated（可重新生成，提交以方便纯前端改动）
# src/shared/types/ipc.ts

# ts-rs：crates/* 里 #[ts(export)] 的类型，在 cargo test 时导出到各 crate 的 bindings/
# （前端不用这些文件，规范 TS 类型来自 src/shared/types/ipc.ts）
src-tauri/crates/*/bindings/

# editor / os
.vscode/
.idea/
*.local
.DS_Store
Thumbs.db

# logs
*.log
pnpm-debug.log*

# test / local artifacts
test-results/
playwright-report/

# local agent session files
.zcode/

# temp debug scripts
.dbg*.mjs
.dd*.mjs
.reg*.mjs
.tray-verify.mjs
*.tmp.mjs

# 本地主屏布局调试导出
/.layout-*.json

# agent 工作区（记忆/任务等本地数据）
.workbuddy/
